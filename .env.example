# Database URL (Neon PostgreSQL connection string)
# Example: postgresql://alex:my_password@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://<username>:<password>@<neon_host>/<database>?sslmode=require

# Frontend CORS Origins
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
