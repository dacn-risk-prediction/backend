# Database URL (Neon PostgreSQL connection string)
# Example: postgresql://alex:my_password@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://<username>:<password>@<neon_host>/<database>?sslmode=require

# Frontend CORS Origins
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# AI/ML Model Service
MODEL_SERVICE_URL=http://localhost:8001

# Gemini AI Advisor (Optional - single key or comma-separated keys from separate Projects for round-robin)
# Recommended models:
# - gemini-4-hydrogen (GEMINI_THINKING_LEVEL=low, GEMINI_TIMEOUT_SECONDS=12.0) -> highest advisor precision
# - gemini-3.5-flash-lite (GEMINI_THINKING_LEVEL=minimal, GEMINI_TIMEOUT_SECONDS=5.0) -> lowest latency (<1s)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_THINKING_LEVEL=low
GEMINI_TIMEOUT_SECONDS=12.0
AI_ADVICE_CACHE_TTL_DAYS=7

